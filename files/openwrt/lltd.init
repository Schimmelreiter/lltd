#!/bin/sh /etc/rc.common
# lltd - Link Layer Topology Discovery responder (Windows network map)
# Options: /etc/config/lltd, documentation: /etc/config.readme/lltd.readme

START=95
USE_PROCD=1

start_service() {
	local enabled interfaces hostname friendly icon web nat fdb fdb_hold speed verbose
	local net dev args="" count=0

	config_load lltd
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get interfaces main interface lan
	config_get hostname main hostname
	config_get friendly main friendly_name
	config_get icon main icon
	config_get_bool web main web 1
	config_get nat main nat_private auto
	config_get_bool fdb main fdb 1
	config_get fdb_hold main fdb_hold
	config_get speed main speed
	config_get verbose main verbose 0

	# default friendly name: the board model, e.g. "Linksys WRT1900ACS"
	[ -n "$friendly" ] || friendly="$(cat /tmp/sysinfo/model 2>/dev/null)"
	# private side of a NAT: this device routes to a WAN network
	[ "$nat" = auto ] && { uci -q get network.wan >/dev/null && nat=1 || nat=0; }

	. /lib/functions/network.sh
	for net in $interfaces; do
		network_get_device dev "$net" || dev=""
		if [ -n "$dev" ]; then
			args="$args -i $dev"
			count=$((count + 1))
		else
			logger -t lltd "network '$net' has no device, skipped"
		fi
	done
	[ "$count" -gt 0 ] || {
		logger -t lltd "no usable interface, not started"
		return 0
	}

	procd_open_instance
	# shellcheck disable=SC2086
	procd_set_param command /usr/sbin/lltd -f -s $args
	[ -n "$hostname" ] && procd_append_param command -H "$hostname"
	[ -n "$friendly" ] && procd_append_param command -F "$friendly"
	[ -n "$icon" ] && procd_append_param command -I "$icon"
	[ "$web" = 1 ] && procd_append_param command -w
	[ "$nat" = 1 ] && procd_append_param command --nat-private
	[ "$fdb" = 1 ] || procd_append_param command --no-fdb
	[ -n "$fdb_hold" ] && procd_append_param command --fdb-hold "$fdb_hold"
	[ -n "$speed" ] && procd_append_param command --speed "$speed"
	while [ "$verbose" -gt 0 ]; do
		procd_append_param command -v
		verbose=$((verbose - 1))
	done
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	# host name or icon changed: restart, so lltd reads everything again
	stop
	start
}

service_triggers() {
	local interfaces net

	procd_add_reload_trigger lltd system
	config_load lltd
	config_get interfaces main interface lan
	for net in $interfaces; do
		procd_add_reload_interface_trigger "$net"
	done
}
